<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 이하 자동 백업: 소원·학 기록은 WebView localStorage(app_webview)에 있다 -->
<full-backup-content>
    <include domain="root" path="app_webview/" />
    <include domain="sharedpref" path="crane.xml" />
    <exclude domain="root" path="app_webview/Default/Cache/" />
</full-backup-content>
