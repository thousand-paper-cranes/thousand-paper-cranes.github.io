<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : 소원·학 기록(WebView localStorage)을 클라우드 백업과 기기 이전에 포함 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
